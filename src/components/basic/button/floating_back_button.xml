<component>
	<previews>
		<preview style_bg_color="0x888" language="de" />
	</previews>

	<api />

	<styles>
		<!-- Rund, Icon zentriert -->
		<style
			name="style_button"
			bg_color="0x131313"
			border_side="full"
			border_width="1"
			border_color="0x020202"
			shadow_width="0"
			bg_opa="255"
			height="40px"
			width="40px"
			radius="50%"
			pad_all="0px"
		/>
		<style name="style_button_activ" bg_opa="127" />
	</styles>

	<view extends="lv_button" floating="true" align="bottom_right" x="-8px" y="-8px">
		<!-- Bild statt Text -->
		<lv_image name="image" src="back_arrow" align="center" width="20px" height="20px" />

		<style name="style_button_activ" selector="pressed" />
		<style name="style_button" />
		<event_cb trigger="clicked" callback="back_button_handler" />
	</view>
</component>
